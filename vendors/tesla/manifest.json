{
  "name": "Tesla",
  "description": "Vehicle proximity token: iBeacon (0xFF) or 18-char name starting with S plus service UUID 0x1122 (AD 0x02 2211 on air; iOS strips manufacturer data).",
  "version": 3,
  "profile": "ble.json",
  "assets": {
    "icon": "assets/tesla.svg",
    "graphics": "assets/graphics.json"
  },
  "roles": {
    "observer": {
      "entry": "observer/adv_decode.lua",
      "priority": 45,
      "_comment": "After devices/ibeacon (40). Match iBeacon decode OR iOS-stripped name + 0x1122 incomplete UUID list.",
      "scan_conditions": {
        "one_of": [
          {
            "fingerprint_has_entry_id": "ibeacon"
          },
          {
            "device_name_regex": "^S.{17}$",
            "service_uuid_16": "1122"
          }
        ]
      }
    },
    "peripheral": {
      "advertisement": "peripheral/adv.json",
      "entry": "peripheral/tesla_peripheral.lua",
      "interface": "peripheral/interface.json"
    }
  },
  "manifest_version": 1
}
